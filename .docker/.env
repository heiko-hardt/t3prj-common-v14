# Project settings
PROJECT_NAME=heikohardt-t3prj-common-v14-env

# Compose settings
COMPOSE_PROJECT_NAME=$PROJECT_NAME

# Databse settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=application
DB_USER=developer
DB_PASSWORD=P@ssw0rd

# PHP
XDEBUG_MODE=debug,develop,coverage

# MySQL
MYSQL_ALLOW_EMPTY_PASSWORD=yes
MYSQL_DATABASE="$DB_DATABASE"
MYSQL_PASSWORD="$DB_PASSWORD"
MYSQL_USER="$DB_USER"

# TYPO3 environment
TYPO3_CONTEXT=Development/Docker
# debug settings
TYPO3__BE__debug=BOOL:true
TYPO3__FE__debug=BOOL:true
TYPO3__SYS__devIPmask='*'
TYPO3__SYS__displayErrors=INT:1
TYPO3__SYS__exceptionalErrors=INT:12290
TYPO3__SYS__trustedHostsPattern='.*'
# site settings
TYPO3__SYS__sitename='TYPO3 Common v.14.3 LTS'
TYPO3__SYS__systemLocale='en_US.UTF-8'
# uncomment on github codespaces
TYPO3__SYS__reverseProxyIP='*'
TYPO3__SYS__reverseProxyHeaderMultiValue='first'
TYPO3__SYS__reverseProxySSL='*'
